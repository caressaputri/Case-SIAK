      <packagedElement xmi:type="uml:Package" xmi:id="_pkg_dpostcheckirs" name="DPostCheckIRS">
        <packagedElement xmi:type="uml:Class" xmi:id="_cls_dpost_pembimpl" name="PembayaranImpl">
